# IP del reloj ZKTeco K30 en la red local del hotel
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370

# URL del endpoint de importacion del sistema RRHH (con https:// completo)
API_URL=https://tu-dominio-del-sistema.com/api/asistencias/importar

# Debe ser identico al ASISTENCIA_TOKEN configurado en el .env del backend
API_TOKEN=

# Password de comunicacion del reloj (0 si no tiene configurada ninguna)
DEVICE_PASSWORD=0
